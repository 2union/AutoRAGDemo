OPENAI_API_KEY=sk-...
# Адрес OpenAI-совместимого API (прокси, Azure-шлюз и т.п.). Пусто — https://api.openai.com/v1
OPENAI_BASE_URL=
QDRANT_URL=http://qdrant:6333
# Итоговая продакшн-коллекция (не пересекается с DirectIndex: chef_recipes)
QDRANT_COLLECTION=chef_recipes_autorag
# Модель для генерации синтетического QA-датасета (сильнее, чем целевая)
QA_MODEL=gpt-5-mini
# Целевая модель, для которой готовится контекст
GENERATION_MODEL=gpt-5-nano
# reasoning_effort для gpt-5-nano (minimal|low|medium|high); пусто — не передавать
REASONING_EFFORT=low
# Логировать запросы к OpenAI (заголовок Authorization маскируется)
DEBUG=false
